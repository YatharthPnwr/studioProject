# Path to your joined parquet file in GCS
GCS_PARQUET_PATH=gs://your-bucket-name/path/to/joined.parquet

# Optional: local parquet file for testing (used as fallback)
LOCAL_PARQUET_PATH=./data/joined.parquet

# Optional: path to GCP service account key (uses Application Default Credentials if unset)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# API server
API_HOST=0.0.0.0
API_PORT=8000
